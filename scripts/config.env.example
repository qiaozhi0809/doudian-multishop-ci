# 本机服务配置（可选）
# start.ps1 会读取本文件，每行 KEY=VALUE；# 开头为注释。
# 完整配置项见 docs/design/deployment.md 第 4 节。示例：
#
# 演练模式：所有写操作只记录请求，不发真实写请求
# DD_DRY_RUN=false
#
# 数据目录（默认 %LOCALAPPDATA%\doudian-multishop）
# DD_DATA_DIR=D:\doudian-data
#
# 每日对账 / 备份时间（本地时间 0-23 点）
# DD_RECONCILE_HOUR=3
# DD_BACKUP_HOUR=4
# DD_BACKUP_KEEP=7
#
# 临近发货超时告警阈值（小时）
# DD_SHIP_DEADLINE_WARN_HOURS=6
