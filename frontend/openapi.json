{
  "openapi": "3.1.0",
  "info": {
    "title": "抖店多店铺管理 本地 API",
    "version": "0.0.0-handwritten",
    "description": "临时手写，后端 Task 14 导出后替换。仅覆盖 M1 前端 Task 1~4 所需：/api/health、/api/auth/*、/api/shops 列表、/api/orders、/api/orders/counts。字段依据 docs/design/local-api.md、data-model.md 与 M1 后端计划 Task 13/14，导出后以后端为准。"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "总体健康",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "错误信封",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/status": {
      "get": {
        "summary": "登录状态",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatus"
                }
              }
            }
          },
          "default": {
            "description": "错误信封",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/setup": {
      "post": {
        "summary": "创建管理员",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatus"
                }
              }
            }
          },
          "default": {
            "description": "错误信封",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "登录",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatus"
                }
              }
            }
          },
          "default": {
            "description": "错误信封",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "退出",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "错误信封",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/password": {
      "post": {
        "summary": "修改密码",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "错误信封",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePassword"
              }
            }
          }
        }
      }
    },
    "/api/shops": {
      "get": {
        "summary": "店铺列表与会话健康",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShopRow"
                  }
                }
              }
            }
          },
          "default": {
            "description": "错误信封",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders": {
      "get": {
        "summary": "跨店订单列表",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderPage"
                }
              }
            }
          },
          "default": {
            "description": "错误信封",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "shop_ids",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ]
      }
    },
    "/api/orders/counts": {
      "get": {
        "summary": "跨店 tab 计数（平台口径）",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderCountsResponse"
                }
              }
            }
          },
          "default": {
            "description": "错误信封",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "shop_ids",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "shop_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "detail": {}
        },
        "required": [
          "type",
          "message"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "AuthStatus": {
        "type": "object",
        "properties": {
          "setup_required": {
            "type": "boolean"
          },
          "logged_in": {
            "type": "boolean"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "setup_required",
          "logged_in",
          "username"
        ]
      },
      "Credentials": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "ChangePassword": {
        "type": "object",
        "properties": {
          "old_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string"
          }
        },
        "required": [
          "old_password",
          "new_password"
        ]
      },
      "ShopRow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "needs_login",
              "disabled"
            ]
          },
          "health": {
            "anyOf": [
              {
                "enum": [
                  "healthy",
                  "expiring",
                  "expired"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "paused_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "egress_mode": {
            "anyOf": [
              {
                "enum": [
                  "direct",
                  "proxy"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "proxy_display": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "egress_ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "egress_ip_pending": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "egress_status": {
            "enum": [
              "unchecked",
              "ok",
              "unreachable",
              "changed",
              "duplicate"
            ]
          },
          "proxy_expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ready_for_label": {
            "type": "boolean"
          },
          "not_ready_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "health",
          "expires_at",
          "paused_reason",
          "egress_mode",
          "proxy_display",
          "egress_ip",
          "egress_ip_pending",
          "egress_status",
          "proxy_expires_at",
          "ready_for_label",
          "not_ready_reasons"
        ]
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "sku_order_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "product_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "product_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sku_spec": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "quantity": {
            "type": "integer"
          },
          "price_cents": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "sku_order_id",
          "product_id",
          "product_name",
          "sku_spec",
          "quantity",
          "price_cents"
        ]
      },
      "OrderRow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "shop_id": {
            "type": "integer"
          },
          "shop_name": {
            "type": "string"
          },
          "order_no": {
            "type": "string"
          },
          "platform_status": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "synced",
              "pending_label",
              "label_obtained",
              "printed",
              "shipped",
              "exception",
              "cancelled",
              "closed"
            ]
          },
          "exception_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "amount_cents": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "pay_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "exp_ship_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          }
        },
        "required": [
          "id",
          "shop_id",
          "shop_name",
          "order_no",
          "platform_status",
          "status",
          "exception_reason",
          "amount_cents",
          "pay_time",
          "exp_ship_time",
          "items"
        ]
      },
      "OrderPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderRow"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ]
      },
      "OrderCounts": {
        "type": "object",
        "properties": {
          "stock_up": {
            "type": "integer"
          },
          "exp_ship": {
            "type": "integer"
          },
          "ship_delay": {
            "type": "integer"
          },
          "in_aftersale": {
            "type": "integer"
          }
        },
        "required": [
          "stock_up",
          "exp_ship",
          "ship_delay",
          "in_aftersale"
        ]
      },
      "ShopOrderCounts": {
        "type": "object",
        "properties": {
          "shop_id": {
            "type": "integer"
          },
          "counts": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrderCounts"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "enum": [
              "upstream",
              "error"
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "shop_id",
          "source"
        ]
      },
      "OrderCountsResponse": {
        "type": "object",
        "properties": {
          "shops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShopOrderCounts"
            }
          }
        },
        "required": [
          "shops"
        ]
      }
    }
  }
}
